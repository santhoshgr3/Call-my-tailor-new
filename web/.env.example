# Local dev uses a SQLite file. For Supabase/Postgres, change the datasource
# provider in prisma/schema.prisma to "postgresql" and put the connection string here.
DATABASE_URL="file:./dev.db"

# Any long random string. Generate one, e.g.: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — set all three to enable online payments at checkout
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
