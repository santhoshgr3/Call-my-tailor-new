# Postgres connection string — required for local dev AND production.
# Vercel Postgres / Neon: paste the string they give you.
# Supabase: Settings -> Database -> Connection string -> URI (Session pooler / :5432).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — set all three to enable online card/UPI payments at checkout
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
